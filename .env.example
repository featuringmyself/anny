# Sanity (anny-cms Studio project)
NEXT_PUBLIC_SANITY_PROJECT_ID=07zs46ej
NEXT_PUBLIC_SANITY_DATASET=production
# Hosted Studio URL for Visual Editing / stega (defaults to https://anny.sanity.studio)
# NEXT_PUBLIC_SANITY_STUDIO_URL=https://anny.sanity.studio

# Viewer token from sanity.io/manage — enables Live Content API + draft preview
SANITY_API_READ_TOKEN=

# Optional override; defaults to https://dodoxhq.com in lib/site.ts
# NEXT_PUBLIC_SITE_URL=https://dodoxhq.com

# PostHog — browser + server analytics
# Client posts via /ingest; NEXT_PUBLIC_POSTHOG_HOST is used by posthog-node on the server.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# MongoDB — leads, signups, audit orders (defaults DB name to anny_landing)
DB_URI=
# DB_NAME=anny_landing

# Ahrefs — Domain Rating checker
AHREF_API_KEY=

# Dodo Payments — /audit checkout (localized pricing)
# One product: INR base (India) + by_country US → USD
# API key needs checkout_sessions:write (Editor). Viewer keys cannot create sessions.
# Webhook: POST https://www.dodoxhq.com/api/webhooks/dodo
# Events: payment.succeeded, payment.failed, refund.succeeded
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_PRODUCT_ID_AUDIT=
# Optional: bun run dodo:setup-audit
